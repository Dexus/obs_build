#
# spec file for package caddy2
#
# Caddy web server built from a wrapper module with third-party plugins
# compiled in (currently github.com/mholt/caddy-ratelimit).
#
# Dependencies are vendored by the "go_modules" source service (see _service),
# which regenerates vendor.tar.gz on the OBS server. Build workers are offline:
# %prep untars the wrapper module and the vendor archive, %build compiles with
# -mod=vendor and no network access.

Name:           caddy2
Version:        2.10.1
Release:        0
Summary:        Web server with automatic HTTPS, with rate limiting module compiled in
License:        Apache-2.0
Group:          Productivity/Networking/Web/Servers
URL:            https://caddyserver.com
Source0:        caddy2-%{version}.tar.gz
# Regenerated by the go_modules source service from Source0; can also be
# produced locally by update-sources.sh
Source1:        vendor.tar.gz
Source2:        caddy.service
Source3:        Caddyfile
ExclusiveArch:  x86_64 aarch64 ppc64le s390x riscv64

%if 0%{?suse_version}
BuildRequires:  golang(API) >= 1.25
%else
BuildRequires:  golang >= 1.25
%endif
BuildRequires:  systemd-rpm-macros

%description
Caddy is an HTTP/2 and HTTP/3 capable web server with automatic HTTPS.

This package is built from a small wrapper module so that third-party
plugins are compiled into the binary, currently:

* github.com/mholt/caddy-ratelimit: the rate_limit directive for
  internal and distributed HTTP rate limiting
  (https://github.com/mholt/caddy-ratelimit).

Run "caddy list-modules" to verify the compiled-in modules, and
"caddy version" — it reports a "+ratelimit" version suffix.

%prep
%setup -q -n caddy2-%{version}
tar -xf %{SOURCE1}

%build
# Static, reproducible, offline build from the vendored dependencies.
export CGO_ENABLED=0
export GOTOOLCHAIN=local
export GOFLAGS=-mod=vendor
go build -trimpath \
    -ldflags "-s -w -X github.com/caddyserver/caddy/v2.CustomVersion=%{version}+ratelimit" \
    -o caddy .

%install
install -D -m 0755 caddy %{buildroot}%{_bindir}/caddy
install -D -m 0644 %{SOURCE2} %{buildroot}%{_unitdir}/caddy.service
install -D -m 0644 %{SOURCE3} %{buildroot}%{_sysconfdir}/caddy/Caddyfile

%pre
getent group caddy >/dev/null || groupadd -r caddy
getent passwd caddy >/dev/null || useradd -r -g caddy -s /sbin/nologin \
    -c "Caddy web server" -d /var/lib/caddy caddy
%if 0%{?suse_version}
%service_add_pre caddy.service
%endif

%post
%if 0%{?suse_version}
%service_add_post caddy.service
%else
%systemd_post caddy.service
%endif

%preun
%if 0%{?suse_version}
%service_del_preun caddy.service
%else
%systemd_preun caddy.service
%endif

%postun
%if 0%{?suse_version}
%service_del_postun caddy.service
%else
%systemd_postun_with_restart caddy.service
%endif

%files
%license LICENSE
%{_bindir}/caddy
%{_unitdir}/caddy.service
%dir %{_sysconfdir}/caddy
%config(noreplace) %{_sysconfdir}/caddy/Caddyfile

%changelog
* Fri Oct 16 2026 Josef <josef@example.com> - 2.10.1
- Initial package: Caddy 2.10.1 with mholt/caddy-ratelimit compiled in.
